[Unit]
Description=form-filler (bot do Telegram do Espaço Livre)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=formfiller
WorkingDirectory=/opt/form-filler
ExecStart=/opt/form-filler/.venv/bin/python -m form_filler.bot
Restart=always
RestartSec=30

[Install]
WantedBy=multi-user.target
